# ─── Còpia aquest fitxer a .env i omple els valors ───
# cp .env.example .env

# ─── Base de dades MariaDB ───
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=habitforge
MYSQL_USER=habitforge
MYSQL_PASSWORD=changeme

# ─── Panell d'administració ───
ADMIN_PASSWORD=changeme

# ─── Web Push (VAPID) ───
# Genera les claus amb:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ─── Domini públic (Traefik) ───
# El host on s'exposa l'app darrere Traefik. Per local: localhost
HABITFORGE_HOST=localhost
